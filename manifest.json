{
  "manifest_version": 3,
  "name": "Relay",
  "short_name": "Relay",
  "version": "2.0.0",
  "description": "Search Google or send prompts and files to AI services from your new tab.",
  "homepage_url": "https://github.com/algorirhy/one-ai-shortcut",
  "permissions": ["tabs", "notifications", "storage"],
  "commands": {
    "new-chat": {
      "suggested_key": {
        "default": "Ctrl+Shift+O",
        "mac": "Command+Shift+O"
      },
      "description": "Start a new chat on the current supported AI site"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/relay-16.png",
    "32": "icons/relay-32.png",
    "48": "icons/relay-48.png",
    "128": "icons/relay-128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://gemini.google.com/*",
        "https://www.doubao.com/*",
        "https://doubao.com/*"
      ],
      "js": ["sites.js", "attachments.js", "page-main.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://www.google.com/*", "https://google.com/*"],
      "include_globs": [
        "*://*.google.com/ai",
        "*://*.google.com/ai/*",
        "*://*.google.com/ai?*",
        "*://*.google.com/aimode*",
        "*://*.google.com/webhp?*aep=11*",
        "*://*.google.com/search?*udm=50*"
      ],
      "js": ["sites.js", "attachments.js", "content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://claude.ai/*",
        "https://gemini.google.com/*",
        "https://grok.com/*",
        "https://chat.deepseek.com/*",
        "https://www.deepseek.com/*",
        "https://www.doubao.com/*",
        "https://doubao.com/*"
      ],
      "js": ["sites.js", "attachments.js", "content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Open Relay",
    "default_icon": {
      "16": "icons/relay-16.png",
      "32": "icons/relay-32.png"
    }
  },
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  }
}
